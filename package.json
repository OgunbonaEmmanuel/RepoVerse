{
  "name": "repoverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "vitest run tests/scale.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests e2e *.ts *.mts package.json tsconfig.json README.md",
    "format:check": "prettier --check app components lib tests e2e *.ts *.mts package.json tsconfig.json README.md"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "next": "^16.0.0",
    "openai": "6.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
